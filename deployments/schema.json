{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/snissn/filecoin-boss/deployments/schema.json",
  "title": "Filecoin Boss deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "chainId",
    "protocolCommit",
    "deploymentCommit",
    "deployer",
    "governance",
    "accountCreationCodeHash",
    "deploymentBlock",
    "dependencies",
    "dependencyRuntimeCodeHashes",
    "contracts",
    "smokeAccount"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "network": {
      "type": "string",
      "minLength": 1
    },
    "chainId": {
      "type": "integer",
      "minimum": 1
    },
    "protocolCommit": {
      "$ref": "#/$defs/commit"
    },
    "deploymentCommit": {
      "$ref": "#/$defs/commit"
    },
    "deployer": {
      "$ref": "#/$defs/address"
    },
    "governance": {
      "$ref": "#/$defs/address"
    },
    "accountCreationCodeHash": {
      "$ref": "#/$defs/hash"
    },
    "deploymentBlock": {
      "type": "integer",
      "minimum": 0
    },
    "dependencies": {
      "$ref": "#/$defs/dependencyAddresses"
    },
    "dependencyRuntimeCodeHashes": {
      "$ref": "#/$defs/dependencyHashes"
    },
    "contracts": {
      "type": "object",
      "minProperties": 9,
      "required": [
        "BossFactory",
        "BossServiceRegistry",
        "BossAdapterRegistry",
        "BossBundles",
        "BossStateView",
        "FlatRateAdapter",
        "PDPCapacityAdapter",
        "CappedMeteredAdapter",
        "FWSSPDPResourceAdapter"
      ],
      "propertyNames": {
        "enum": [
          "BossFactory",
          "BossServiceRegistry",
          "BossAdapterRegistry",
          "BossBundles",
          "BossStateView",
          "FlatRateAdapter",
          "PDPCapacityAdapter",
          "CappedMeteredAdapter",
          "FWSSPDPResourceAdapter"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/deployment"
      }
    },
    "smokeAccount": {
      "$ref": "#/$defs/smokeAccount"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "dependencyAddresses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filecoinPay",
        "pdpVerifier",
        "fwssService",
        "fwssStateView",
        "token"
      ],
      "properties": {
        "filecoinPay": {
          "$ref": "#/$defs/address"
        },
        "pdpVerifier": {
          "$ref": "#/$defs/address"
        },
        "fwssService": {
          "$ref": "#/$defs/address"
        },
        "fwssStateView": {
          "$ref": "#/$defs/address"
        },
        "token": {
          "$ref": "#/$defs/address"
        }
      }
    },
    "dependencyHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filecoinPay",
        "pdpVerifier",
        "fwssService",
        "fwssStateView",
        "token"
      ],
      "properties": {
        "filecoinPay": {
          "$ref": "#/$defs/hash"
        },
        "pdpVerifier": {
          "$ref": "#/$defs/hash"
        },
        "fwssService": {
          "$ref": "#/$defs/hash"
        },
        "fwssStateView": {
          "$ref": "#/$defs/hash"
        },
        "token": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "runtimeCodeHash",
        "deploymentTxHash",
        "deploymentBlock"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/hash"
        },
        "deploymentTxHash": {
          "$ref": "#/$defs/hash"
        },
        "deploymentBlock": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "smokeAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "owner",
        "runtimeCodeHash",
        "deploymentTxHash",
        "deploymentBlock"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "owner": {
          "$ref": "#/$defs/address"
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/hash"
        },
        "deploymentTxHash": {
          "$ref": "#/$defs/hash"
        },
        "deploymentBlock": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
